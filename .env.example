# =============================================================================
# WisdomHub 本地开发中间件凭据示例
#
# 使用方式：
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
#   docker compose up -d
#
# 所有密码均为占位符，复制为 .env 后请自行修改；切勿用于任何公网环境。
# =============================================================================

# MySQL root（同时供 xxl-job-admin 连接 xxl_job 库）
MYSQL_ROOT_PASSWORD=change-me

# MongoDB
MONGO_USER=wisdomhub
MONGO_PASSWORD=change-me

# Neo4j：密码长度至少 8 位，否则容器拒绝启动
NEO4J_PASSWORD=change-me

# RabbitMQ（AMQP / 管理台 / STOMP 共用）
RABBITMQ_USER=wisdomhub
RABBITMQ_PASSWORD=change-me

# Nacos 3 认证令牌：必须是 Base64，且解码后原文长度 >= 32 字节
# 生成：openssl rand -base64 32
NACOS_AUTH_TOKEN="REPLACE_WITH_BASE64_32_BYTES"

# PostgreSQL（agent-engine 独占的 wisdomhub_agent 库）
POSTGRES_PASSWORD=change-me
