<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wisdomhub</groupId>
    <artifactId>wisdomhub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>WisdomHub</name>
    <description>WisdomHub 开发者技术知识社区平台 - Maven 父工程</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 微服务体系 -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <!-- 以下几项 Boot / Spring Cloud / SCA 的 BOM 都未覆盖，需在此统一管版本 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <velocity.version>2.4.1</velocity.version>
        <springdoc.version>2.9.1</springdoc.version>
        <jjwt.version>0.13.0</jjwt.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <hutool.version>5.8.47</hutool.version>
        <flexmark.version>0.64.8</flexmark.version>
        <jsoup.version>1.18.3</jsoup.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== BOM 导入：子模块据此获得版本管理能力 ===== -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              注意：Spring Boot 自身及其生态的依赖，版本已由父 POM spring-boot-starter-parent
              统一管理，此处不再重复声明。子模块直接写 groupId + artifactId 即可，无需写 version。
              涵盖：spring-boot-starter-web / webflux / validation / actuator / cache /
                    data-redis / data-mongodb / data-elasticsearch / data-neo4j / amqp /
                    websocket / test、mybatis 无关的 mysql-connector-j、lombok、
                    caffeine、commons-pool2、spring-security-crypto 等。
              同样，spring-cloud-starter-gateway / openfeign / loadbalancer 由 Spring Cloud BOM 管理，
              spring-cloud-starter-alibaba-nacos-discovery / nacos-config / seata 由 SCA BOM 管理。
              下面只列上述 BOM 都未覆盖的第三方。
            -->

            <!-- ORM：技术文档 7.7 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MP 把依赖 jsqlparser 的 inner interceptor（含 PaginationInnerInterceptor）拆到了这个模块，
                 只引 starter 拿不到，selectPage 会静默退化成查全表 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 代码生成器：只在 common-core 以 optional 引入，不下发给任何服务的运行时 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- generator 把各模板引擎都标成了 optional，引擎得由我们显式声明 -->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.version}</version>
            </dependency>

            <!-- 接口文档：任务 B1.31。Servlet 服务用 mvc，Gateway(响应式) 用 webflux -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- common-core 用它给 R<T> 提供 @Schema 注解（与 UI 栈无关，不碰 servlet） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- JWT：技术文档 7.17。三个 artifact 版本必须一致，故一并纳入管理 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- 定时任务：技术文档 7.15 -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- hutool 工具包 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Markdown 渲染（B1.18）：只引需要的扩展，不用 flexmark-all 那套全家桶 -->
            <dependency>
                <groupId>com.vladsch.flexmark</groupId>
                <artifactId>flexmark</artifactId>
                <version>${flexmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vladsch.flexmark</groupId>
                <artifactId>flexmark-ext-tables</artifactId>
                <version>${flexmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vladsch.flexmark</groupId>
                <artifactId>flexmark-ext-gfm-strikethrough</artifactId>
                <version>${flexmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vladsch.flexmark</groupId>
                <artifactId>flexmark-ext-autolink</artifactId>
                <version>${flexmark.version}</version>
            </dependency>

            <!-- HTML 白名单消毒（B1.18）：Markdown 渲染完要过一遍，否则内联 <script> 会被存库并原样返回 -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>wisdomhub-common</module>
        <module>wisdomhub-gateway</module>
        <module>wisdomhub-user</module>
        <module>wisdomhub-content</module>
        <module>wisdomhub-search</module>
        <module>wisdomhub-knowledge</module>
        <module>wisdomhub-recommendation</module>
        <module>wisdomhub-notification</module>
        <module>wisdomhub-order</module>
    </modules>
</project>
