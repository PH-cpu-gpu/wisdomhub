# 开发环境覆盖项。
#
# VITE_API_BASE_URL 保持 /api 的相对路径不写死 host：浏览器只跟 dev server 说话，
# 由 vite.config.ts 的 proxy 转发到网关。这样开发与生产（Nginx 反代 /api）同构，
# 业务代码里永远只写 /api，不需要按环境分支。
VITE_API_BASE_URL=/api

# 仅 dev server 的 proxy 用，不会进产物。
# 网关端口见 wisdomhub-gateway/src/main/resources/application.yml（9090）。
VITE_API_PROXY_TARGET=http://127.0.0.1:9090
