# ---------------------------------------------------------------------------
# 环境变量清单。以 VITE_ 开头的变量才会被 Vite 注入到客户端代码。
# 真实值在 .env / .env.development / .env.production，本文件只是模板。
#
#   cp .env.example .env.local     # 需要本地私有覆盖时
#
# ⚠️ 这里放的东西会原样打进 JS 产物、任何人打开 DevTools 都能看到。
#    后端地址、功能开关可以放；密钥、token、凭证一律不可以。
# ---------------------------------------------------------------------------

# 浏览器标签页标题，同时用作默认页面标题
VITE_APP_TITLE=WisdomHub

# 接口前缀。保持 `/api` 相对路径，由 dev server 的 proxy / 生产的 Nginx 转发到网关。
# 只有在前端与网关不同源、且无法配反代时，才改成完整地址（如 http://127.0.0.1:9090/api）。
VITE_API_BASE_URL=/api

# 仅开发环境使用：vite dev server 把 /api 转发到哪。
# 网关端口见 wisdomhub-gateway/src/main/resources/application.yml。
VITE_API_PROXY_TARGET=http://127.0.0.1:9090
