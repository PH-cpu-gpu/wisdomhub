# ---------------------------------------------------------------------------
# 所有环境共享的配置。这里只有构建期会被打进产物的公开变量（VITE_ 前缀），
# 不含任何密钥 —— 密钥绝不能放前端，浏览器里能看到的都不是秘密。
#
# 环境相关的覆盖项放在 .env.development / .env.production 里。
# 变量清单与含义见 .env.example。
# ---------------------------------------------------------------------------

VITE_APP_TITLE=WisdomHub
