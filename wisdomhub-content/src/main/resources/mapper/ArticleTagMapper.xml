<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wisdomhub.content.mapper.ArticleTagMapper">
    
    <insert id="insertBatch">
        INSERT INTO article_tag (id, article_id, tag_id, create_time)
        VALUES
        <foreach collection="articleTagList" item="item" separator=",">
            (#{item.id}, #{item.articleId}, #{item.tagId}, #{item.createTime})
        </foreach>
    </insert>
</mapper>