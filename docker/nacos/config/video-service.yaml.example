# =============================================================================
# Nacos 配置模板（已脱敏）
# DataId   : video-service.yaml
# Group    : DEFAULT_GROUP
# Namespace: wisdomhub
#
# 导入前请把 change-me / your-xxx 占位符替换为实际值。
# 导入方式见 docker/nacos/README.md
# =============================================================================
spring:
  datasource:
    url: jdbc:mysql://${infra.mysql-host}:${infra.mysql-port}/wisdomhub_video?characterEncoding=utf8&${infra.mysql-params}
    username: ${infra.mysql-user}
    password: ${infra.mysql-password}
    driver-class-name: com.mysql.cj.jdbc.Driver
xxl:
  job:
    executor:
      appname: wisdomhub-video-executor
      port: 9993
      log-path: ./logs/xxl-job
      log-retention-days: 30

springdoc:
  api-docs:
    path: /api/video/v3/api-docs

wisdomhub:
  video:
    upload:
      max-size-bytes: 2147483648   # 2 GiB，B6.13 再按用户收紧
      ticket-ttl-seconds: 900      # 预签名 URL 有效期
    mps:
      transcode-template-id: 1851084
      snapshot-template-id: 191268
      poll-batch-size: 50
      timeout-minutes: 120
      snapshot-time-offset-seconds: 1
