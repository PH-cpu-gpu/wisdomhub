<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wisdomhub</groupId>
        <artifactId>wisdomhub</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wisdomhub-agent</artifactId>
    <name>wisdomhub-agent</name>
    <description>Agent Java 编排层：鉴权、会话、上下文组装、结果落库、SSE 转发（技术文档 5.9、15）</description>

    <dependencies>
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-exception</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 会话状态与限流 -->
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 上下文组装：并行 Feign 调 user / content / search / knowledge（技术文档 8.5） -->
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-feign</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 消费 article.created 触发 AI 文章分析 -->
        <dependency>
            <groupId>com.wisdomhub</groupId>
            <artifactId>common-mq</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          本模块使用 Spring MVC（Servlet）栈向客户端提供 SSE —— SseEmitter 即可满足 B3.3 的流式转发需求。
          B3.3 若改为用 WebClient 转发 Python 的 SSE 流，再单独引入 spring-webflux 即可
          （注意：不要引入 spring-boot-starter-webflux，否则会与 starter-web 的 Servlet 栈冲突）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MongoDB: wisdomhub_agent（对话记录 / 执行过程 / 分析结果，技术文档 7.12） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
