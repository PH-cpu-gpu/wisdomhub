# =============================================================================
# wisdomhub-agent 配置示例
# 复制为 .env 后填写
# =============================================================================

# ---- app ----
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true
APP_PORT=8000
# SSE 空闲兜底（秒），必须大于 CHAT_TIMEOUT
STREAM_IDLE_TIMEOUT=90
# assistant in_progress 行的接管时限（秒）
MESSAGE_IN_PROGRESS_TTL=300

# ---- db ----
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://wisdomhub:change-me@127.0.0.1:5432/wisdomhub_agent
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---- llm ----
# 必填项：缺失或为空则启动失败
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_BASE_URL=https://api.siliconflow.cn/v1
# 真实密钥只放本地 .env，不要提交到仓库
CHAT_API_KEY=
CHAT_TEMPERATURE=0.3
CHAT_TIMEOUT=60
# 文章分析：长任务 LLM 超时（秒）与正文 token 上限
ANALYSIS_TIMEOUT=600
ANALYSIS_MAX_ARTICLE_TOKENS=24000
# 提案自检 reflection 超时（秒）
PROPOSAL_REFLECTION_TIMEOUT=30
# 结构化输出解析失败重试次数；1 = 总共 2 次
STRUCTURED_RETRY_TIMES=1

# ---- nacos ----
# false 跳过 Nacos 注册与配置拉取（学习路线降级为 503）
NACOS_ENABLED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=wisdomhub
NACOS_REGISTER_IP=127.0.0.1
# 注册名是网关契约，改名需同步网关配置
NACOS_SERVICE_NAME=wisdomhub-agent
NACOS_GROUP=DEFAULT_GROUP
NACOS_COMMON_DATA_ID=wisdomhub-common.yaml
NACOS_ENV_DATA_ID=wisdomhub-env.yaml

# ---- mq ----
# false 跳过消费与分析服务装配（文章分析接口降级为 503）
RABBITMQ_ENABLED=true
# 为空则从 Nacos 的 infra.rabbitmq-* 读取
RABBITMQ_URL=
RABBITMQ_RECONNECT_INTERVAL=5
# 额外重试次数；2 = 总共 3 次
ANALYSIS_RETRY_TIMES=2
# in_progress 抢占租约（秒），要盖住最坏 3 次分析
ARTICLE_ANALYSIS_TTL=1800

# ---- limits ----
# 上下文窗口：轮数 + token 双预算（token 用 cl100k_base 近似）
CONTEXT_MAX_TURNS=20
CONTEXT_MAX_TOKENS=12000
CONTEXT_MESSAGE_MAX_TOKENS=2000
# 提案申请：每小时每用户最多提交几次（进程内限流）
PROPOSAL_RATE_LIMIT_PER_HOUR=5
# Python -> Java /internal/**：连接 1s / 查询 3s / 长任务 10m
INTERNAL_CONNECT_TIMEOUT=1
INTERNAL_QUERY_TIMEOUT=3
INTERNAL_LONG_TIMEOUT=600
INTERNAL_RETRY_TIMES=1
