# LLM —— 必填，缺失则启动失败
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_TEMPERATURE=0.3
CHAT_TIMEOUT=60
# 文章分析：长任务 LLM 超时（秒）与正文 token 上限
ANALYSIS_TIMEOUT=600
ANALYSIS_MAX_ARTICLE_TOKENS=24000

# 文章分析 MQ
RABBITMQ_ENABLED=true
# 为空则从 Nacos wisdomhub-common.yaml 的 infra.rabbitmq-* 读取
RABBITMQ_URL=
RABBITMQ_RECONNECT_INTERVAL=5
# 额外重试次数；2 = 总共 3 次
ANALYSIS_RETRY_TIMES=2
# in_progress 抢占租约（秒），要盖住最坏 3 次分析
ARTICLE_ANALYSIS_TTL=1800

# PostgreSQL（agent-engine 独占的 wisdomhub_agent）
DATABASE_URL=postgresql+asyncpg://wisdomhub:change-me@127.0.0.1:5432/wisdomhub_agent
# assistant in_progress 行的接管时限（秒）
MESSAGE_IN_PROGRESS_TTL=300

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=wisdomhub
# 注册进 Nacos 的 IP，必须显式给：SDK 自动探测取的是第一个非 127 网卡，本机上是 Radmin VPN 地址
NACOS_REGISTER_IP=127.0.0.1
# 必须与 uvicorn 实际监听的端口一致，否则 Java 侧按注册的 port 调不通
APP_PORT=8000
# false 跳过 Nacos 注册：本地旁路实例用
NACOS_ENABLED=true
# SSE 空闲兜底（秒），必须大于 CHAT_TIMEOUT；LLM 自己的读超时先触发
STREAM_IDLE_TIMEOUT=90

# 上下文窗口：轮数 + token 双预算（token 用 cl100k_base 近似）
CONTEXT_MAX_TURNS=20
CONTEXT_MAX_TOKENS=12000
CONTEXT_MESSAGE_MAX_TOKENS=2000

# Python -> Java /internal/**
INTERNAL_CONNECT_TIMEOUT=1
INTERNAL_QUERY_TIMEOUT=3
INTERNAL_LONG_TIMEOUT=600
INTERNAL_RETRY_TIMES=1
