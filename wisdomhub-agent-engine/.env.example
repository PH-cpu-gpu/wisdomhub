# LLM —— 必填，缺失则启动失败
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=

# PostgreSQL（agent-engine 独占的 wisdomhub_agent）
DATABASE_URL=postgresql+asyncpg://wisdomhub:change-me@127.0.0.1:5432/wisdomhub_agent
# assistant in_progress 行的接管时限（秒）
MESSAGE_IN_PROGRESS_TTL=300

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=wisdomhub
# 注册进 Nacos 的 IP，必须显式给：SDK 自动探测取的是第一个非 127 网卡，本机上是 Radmin VPN 地址
NACOS_REGISTER_IP=127.0.0.1
# 必须与 uvicorn 实际监听的端口一致，否则 Java 侧按注册的 port 调不通
APP_PORT=8000
# false 跳过 Nacos 注册：本地旁路实例用
NACOS_ENABLED=true
# SSE 两个 chunk 之间的空闲上限（秒），不是整条流的总时长
STREAM_IDLE_TIMEOUT=30
