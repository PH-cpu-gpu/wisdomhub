# 复制成 .env 后填值（.env 已 gitignore）
# 变量名与 app/config.py 的 Settings 字段一一对应（下划线大写），缺项会用代码里的默认值

# LLM —— B3.12 装配 LangChain 时才用，现在留空也行（Settings 里是可选字段）
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=wisdomhub
# 注册进 Nacos 的 IP，必须显式给：SDK 自动探测取的是第一个非 127 网卡，本机上是 Radmin VPN 地址
NACOS_REGISTER_IP=127.0.0.1
# 必须与 uvicorn 实际监听的端口一致，否则 Java 侧按注册的 port 调不通
APP_PORT=8000
