{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "wh_ik_index": {
          "type": "custom",
          "tokenizer": "ik_max_word",
          "filter": ["lowercase"]
        },
        "wh_ik_search": {
          "type": "custom",
          "tokenizer": "ik_smart",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "userId": { "type": "keyword" },
      "username": {
        "type": "text",
        "analyzer": "wh_ik_index",
        "search_analyzer": "wh_ik_search",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 64 }
        }
      },
      "suggest": {
        "type": "completion",
        "analyzer": "wh_ik_index",
        "search_analyzer": "wh_ik_search",
        "max_input_length": 64
      },
      "avatar": { "type": "keyword", "index": false },
      "bio": {
        "type": "text",
        "analyzer": "wh_ik_index",
        "search_analyzer": "wh_ik_search"
      },
      "createTime": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "updateTime": { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
    }
  }
}
