<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wisdomhub.user.mapper.UserFollowMapper">

    <resultMap id="UserBriefResultMap" type="com.wisdomhub.user.domain.vo.UserBriefVO">
        <id column="id" property="userId" />
        <result column="username" property="username" />
        <result column="avatar" property="avatar" />
        <result column="bio" property="bio" />
    </resultMap>

    <!-- 排序用 f.id, 它是雪花 ID 时间有序, 等价于按关注时间倒序 -->
    <select id="selectFollowingPage" resultMap="UserBriefResultMap">
        SELECT u.id, u.username, u.avatar, u.bio
        FROM user_follow f
        JOIN `user` u ON u.id = f.followee_id
        WHERE f.follower_id = #{userId}
        ORDER BY f.id DESC
    </select>

    <select id="selectFansPage" resultMap="UserBriefResultMap">
        SELECT u.id, u.username, u.avatar, u.bio
        FROM user_follow f
        JOIN `user` u ON u.id = f.follower_id
        WHERE f.followee_id = #{userId}
        ORDER BY f.id DESC
    </select>

    <!-- 计数对账用：一次拿到所有人的真值，避免逐个用户 COUNT(*)。
         注意 GROUP BY 不会给出计数为 0 的用户，调用方要用 getOrDefault(id, 0) -->
    <select id="countGroupByFollower" resultType="java.util.Map">
        SELECT follower_id AS userId, COUNT(*) AS cnt
        FROM user_follow
        GROUP BY follower_id
    </select>

    <select id="countGroupByFollowee" resultType="java.util.Map">
        SELECT followee_id AS userId, COUNT(*) AS cnt
        FROM user_follow
        GROUP BY followee_id
    </select>

</mapper>
